# Application
APP_NAME=FastAPI JWT Auth
DEBUG=false

# Database (used by the application and migrations)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_auth

# JWT — replace with a cryptographically random secret in production
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
